# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.nztt4or.mongodb.net/
MONGO_DB=nityaseva

# Long random string used to sign staff sessions (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Comma-separated origins allowed to call the API from a browser
ALLOWED_ORIGINS=https://nityaseva.iskconjiasarai.com,http://localhost:5173

# Vercel sends this as a Bearer token to /api/cron/*
CRON_SECRET=

# Local only (Vercel ignores it)
PORT=3001
